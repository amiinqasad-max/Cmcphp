APP_NAME="CMCPHP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# Supabase-hosted Postgres for this project (binuqasad@gmail.com's Project,
# ref vpsnfsvxurojymjhrslz). Laravel connects directly as a normal Postgres
# role — RLS is enabled with no policies on every table specifically so the
# Supabase anon/authenticated (PostgREST) roles can't reach this data; the
# app is the only intended gateway. Get DB_PASSWORD from Supabase dashboard
# → Project Settings → Database (never commit it). Supabase requires TLS.
DB_HOST=db.vpsnfsvxurojymjhrslz.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=cmcphp_cache

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# S3-compatible object storage. Works with AWS S3, Cloudflare R2, MinIO, etc.
# For Cloudflare R2 set AWS_ENDPOINT to your R2 endpoint and AWS_USE_PATH_STYLE_ENDPOINT=true.
# Set FILESYSTEM_DISK=s3 (with the AWS_* credentials below) for staging/production.
# Locally, without bucket credentials, `public` writes to storage/app/public instead.
FILESYSTEM_DISK=public
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

# ---- CMS-specific ----
# Must NOT collide with Laravel's own session cookie name, which defaults to
# "{app_name_slug}_session" (config/session.php) — e.g. APP_NAME=CMCPHP
# would otherwise produce the exact same "cmcphp_session" name.
ANONYMOUS_SESSION_COOKIE=cmcphp_anon_session
ADSENSE_CLIENT_ID=
