; Example PHP-FPM pool for CMCPHP (§55).
; Drop into /etc/php/8.4/fpm/pool.d/cmcphp.conf and reload php8.4-fpm.
; Tune pm.* to your server's RAM and expected concurrency — these are
; reasonable small/medium-VPS defaults, not a universal answer.

[cmcphp]
user = www-data
group = www-data

listen = /run/php/php8.4-fpm-cmcphp.sock
listen.owner = www-data
listen.group = www-data
listen.mode = 0660

pm = dynamic
pm.max_children = 20
pm.start_servers = 4
pm.min_spare_servers = 2
pm.max_spare_servers = 8
pm.max_requests = 500

; Keep slow-request visibility without spamming logs on normal traffic.
request_terminate_timeout = 120s
slowlog = /var/log/php/cmcphp-slow.log
request_slowlog_timeout = 5s

php_admin_value[error_log] = /var/log/php/cmcphp-error.log
php_admin_flag[log_errors] = on

; Match nginx's client_max_body_size for media/video uploads through the
; Filament admin panel.
php_admin_value[upload_max_filesize] = 64M
php_admin_value[post_max_size] = 64M
php_admin_value[memory_limit] = 256M
